+# --------------------------------------------------------------------------- #
+# P118 - the drop-out pocket station (FRUIT_PICK_STATION=pocket, default off)
+# --------------------------------------------------------------------------- #
+#: The station gap along the belt [m]. P117 measured it: the shutter must fill a
+#: gap wide enough for the stream to pass over it closed and for a fruit to drop
+#: through it open (the fixture's 0.148 m).
+POCKET_GAP = 0.148
+#: The pocket's depth below the belt top [m]. Forced by the shutter's own
+#: thickness (0.020) plus the pool's thickest fruit (0.0696) = 0.0896 -> 0.100
+#: (`logs/p117/RESULTS.md` section 3, lesson 3).
+POCKET_DROP = 0.100
+#: The shutter plate's thickness [m]. Its top is authored flush with the belt top
+#: (`belt_top - thickness/2`); a 20 mm-low plate stopped the stream dead in P117.
+SHUTTER_THICK = 0.020
+#: The shutter's prismatic travel [m]: the gap length, from the closed slot to a
+#: park under the downstream belt (P117 teleported it 2.4 m; the build does not).
+SHUTTER_TRAVEL = POCKET_GAP
+#: The actuator's profile limits. The measured open/close time is the motion's,
+#: and the joint's own limits clamp it (gate 2, `logs/p118/PREREG.md`).
+SHUTTER_VMAX = float(os.environ.get("FRUIT_POCKET_SHUTTER_VMAX", "1.5"))
+SHUTTER_AMAX = float(os.environ.get("FRUIT_POCKET_SHUTTER_AMAX", "12.0"))
+#: The trapdoor floor's slide (the recovery actuator) and its bin depth [m].
+TRAP_TRAVEL = 0.220
+TRAP_VMAX = float(os.environ.get("FRUIT_POCKET_TRAP_VMAX", "0.8"))
+TRAP_AMAX = float(os.environ.get("FRUIT_POCKET_TRAP_AMAX", "6.0"))
+BIN_DEPTH = 0.160
+
+
+class PocketStation:
+    """The drop-out pocket under the pick station: shutter + trapdoor floor.
+
+    Authored only when ``SceneConfig.pick_station_kind == "pocket"``; the
+    continuous belt's build path is untouched at the shipped default, so the
+    scene adds no body when the knob is unset (`assets.scene_provenance` names
+    the resolved station).
+
+    **The shutter is kinematic and belt-like**, on a `UsdPhysics.PrismaticJoint`
+    to a fixed anchor (axis Y, limits ``[-0.148, 0]``, a position target). A
+    static plate drags a fruit to a stop in ``v^2/(2 mu g)`` = 0.6 mm (P117), so
+    the surface velocity is not optional; and a kinematic body does not contact
+    the (kinematic) belt slab, which is what lets the plate park **under the
+    downstream belt** without cutting a slot in it. The joint's position target
+    is integrated as a bounded trapezoid (``v_max`` 1.5 m/s, ``a_max`` 12 m/s^2)
+    into the body pose each control tick: the open/close **time is produced by
+    the travel**, and the joint's limits clamp it - the fixture's teleport is
+    gone.
+
+    **The floor is the recovery actuator**: a second prismatic joint (same form,
+    0.220 m along -Y) slides the floor out from under an un-picked occupant,
+    which falls ``BIN_DEPTH`` into a recycle bin below. The bin is shallower than
+    the spawner's ``fell_off`` line (0.25 m below the belt centre), so a dumped
+    fruit is not counted as a line loss; the task parks it explicitly
+    (`[pocket] dump`).
+
+    Both servos are idempotent per physics tick: `step()` stamps
+    `SimulationManager.get_simulation_time()` and advances by the *measured*
+    delta, so a tick that calls it twice (the wait loop's `enforce_transport` and
+    `_step_sim`) moves the actuator once.
+    """
+
+    def __init__(self, stage: Usd.Stage, cfg: SceneConfig):
+        self.stage = stage
+        self.cfg = cfg
+        bx, by, bz = (float(v) for v in cfg.belt_center)
+        sx, sy, sz = (float(v) for v in cfg.belt_size)
+        self.bx = bx
+        self.belt_top = bz + sz / 2.0
+        self.floor_top = self.belt_top - POCKET_DROP
+        self.mouth_y = float(cfg.pick_y)
+        self.width = sx
+        self.gap = POCKET_GAP
+        self.shutter_closed_z = self.belt_top - SHUTTER_THICK / 2.0
+        self.shutter_path = "/World/Conveyor/PocketShutter"
+        self.trapdoor_path = "/World/Conveyor/PocketTrapdoor"
+        self._shutter_target = 0.0
+        self._shutter_pos = 0.0
+        self._shutter_vel = 0.0
+        self._trap_target = 0.0
+        self._trap_pos = 0.0
+        self._trap_vel = 0.0
+        self._last_t: float | None = None
+        self._shutter_prim = None
+        self._trap_prim = None
+        #: Measurement accumulators (pure reporting): the last completed motion's
+        #: tick count, and the peak speed the profile produced.
+        self.metrics = {
+            "open_ticks": 0,
+            "close_ticks": 0,
+            "open_time_s": float("nan"),
+            "close_time_s": float("nan"),
+            "open_peak_v": 0.0,
+            "close_peak_v": 0.0,
+            "trap_ticks": 0,
+            "trap_time_s": float("nan"),
+        }
+
+    # ------------------------------------------------------------------ #
+    def build(self) -> None:
+        """Author the pocket, the two actuators and the bin (pocket mode only)."""
+        cfg = self.cfg
+        bx, by, bz = (float(v) for v in cfg.belt_center)
+        sx, sy, sz = (float(v) for v in cfg.belt_size)
+        belt_top = self.belt_top
+        floor_top = self.floor_top
+        gap = self.gap
+        say(
+            f"[pocket] station=pocket belt split at pick_y={self.mouth_y:+.4f} "
+            f"gap={gap * 1000:.1f}mm floor_z={floor_top:.4f} (belt_top-{POCKET_DROP * 1000:.0f}mm) "
+            f"belt x=[{bx - sx / 2:.3f},{bx + sx / 2:.3f}]"
+        )
+
+        # ---- the shutter: flush, belt-like, prismatic along -Y ------------ #
+        shutter = _define_box(
+            self.stage, self.shutter_path,
+            size=(sx, gap, SHUTTER_THICK),
+            center=(bx, self.mouth_y, self.shutter_closed_z),
+        )
+        _set_color(shutter, (0.20, 0.55, 0.75))
+        UsdPhysics.CollisionAPI.Apply(shutter.GetPrim())
+        _add_physics_material(shutter.GetPrim(), cfg.belt_friction, cfg.belt_friction, 0.0)
+        body = UsdPhysics.RigidBodyAPI.Apply(shutter.GetPrim())
+        body.CreateKinematicEnabledAttr().Set(True)
+        UsdPhysics.MassAPI.Apply(shutter.GetPrim()).CreateMassAttr().Set(20.0)
+        sv = PhysxSchema.PhysxSurfaceVelocityAPI.Apply(shutter.GetPrim())
+        sv.CreateSurfaceVelocityAttr().Set(
+            Gf.Vec3f(0.0, float(cfg.belt_speed) / max(gap, 1e-6), 0.0)
+        )
+        self._joint("PocketShutterSlide", self.shutter_path, -SHUTTER_TRAVEL,
+                    (bx, self.mouth_y, self.shutter_closed_z))
+
+        # ---- the trapdoor floor + the bin --------------------------------- #
+        floor = _define_box(
+            self.stage, self.trapdoor_path,
+            size=(sx, gap, 0.030),
+            center=(bx, self.mouth_y, floor_top - 0.015),
+        )
+        _set_color(floor, (0.35, 0.42, 0.35))
+        UsdPhysics.CollisionAPI.Apply(floor.GetPrim())
+        _add_physics_material(floor.GetPrim(), 0.6, 0.6, 0.0)
+        fbody = UsdPhysics.RigidBodyAPI.Apply(floor.GetPrim())
+        fbody.CreateKinematicEnabledAttr().Set(True)
+        UsdPhysics.MassAPI.Apply(floor.GetPrim()).CreateMassAttr().Set(10.0)
+        self._joint("PocketTrapSlide", self.trapdoor_path, -TRAP_TRAVEL,
+                    (bx, self.mouth_y, floor_top - 0.015))
+
+        # The pocket's x walls sit just outside the belt edges, so the open hand
+        # (98 mm jaw span) clears them at the delivered band's extremes: the
+        # hand's outer edge at x = 0.188 - 0.049 = 0.139, the wall's inner face
+        # at bx - sx/2 - 0.002 = 0.108.
+        wall_x = sx / 2.0 + 0.008
+        for sign in (-1.0, 1.0):
+            wall = _define_box(
+                self.stage,
+                f"/World/Conveyor/PocketWall{'P' if sign > 0 else 'N'}",
+                size=(0.012, gap, POCKET_DROP + 0.020),
+                center=(bx + sign * wall_x, self.mouth_y,
+                        floor_top + (POCKET_DROP + 0.020) / 2.0),
+            )
+            _set_color(wall, (0.55, 0.60, 0.55))
+            UsdPhysics.CollisionAPI.Apply(wall.GetPrim())
+            _add_physics_material(wall.GetPrim(), 0.6, 0.6, 0.0)
+
+        # The recycle bin: a shallow tray under the pocket floor, deep enough
+        # that a dumped fruit rests above the spawner's `fell_off` line
+        # (belt_center - 0.25); the task recycles it explicitly.
+        bin_top = floor_top - BIN_DEPTH
+        bin_floor = _define_box(
+            self.stage, "/World/Conveyor/PocketBinFloor",
+            size=(sx, 0.34, 0.020), center=(bx, self.mouth_y + 0.02, bin_top - 0.010),
+        )
+        _set_color(bin_floor, (0.30, 0.32, 0.35))
+        UsdPhysics.CollisionAPI.Apply(bin_floor.GetPrim())
+        _add_physics_material(bin_floor.GetPrim(), 0.5, 0.5, 0.0)
+        wall_h = 0.090
+        for dy, tag in ((-0.17, "N"), (0.17, "P")):
+            w = _define_box(
+                self.stage, f"/World/Conveyor/PocketBinWall{tag}",
+                size=(sx, 0.012, wall_h),
+                center=(bx, self.mouth_y + 0.02 + dy, bin_top + wall_h / 2.0),
+            )
+            _set_color(w, (0.40, 0.42, 0.45))
+            UsdPhysics.CollisionAPI.Apply(w.GetPrim())
+            _add_physics_material(w.GetPrim(), 0.5, 0.5, 0.0)
+        for dx, tag in ((-sx / 2 + 0.006, "N"), (sx / 2 - 0.006, "P")):
+            w = _define_box(
+                self.stage, f"/World/Conveyor/PocketBinSide{tag}",
+                size=(0.012, 0.34, wall_h),
+                center=(bx + dx, self.mouth_y + 0.02, bin_top + wall_h / 2.0),
+            )
+            _set_color(w, (0.40, 0.42, 0.45))
+            UsdPhysics.CollisionAPI.Apply(w.GetPrim())
+            _add_physics_material(w.GetPrim(), 0.5, 0.5, 0.0)
+
+        say(
+            f"[pocket] shutter {sx:.3f}x{gap:.3f}x{SHUTTER_THICK:.3f} m top={belt_top:.4f} "
+            f"(flush), prismatic axis Y travel {SHUTTER_TRAVEL:.3f} m -> park y="
+            f"{self.mouth_y - SHUTTER_TRAVEL:+.4f} under the downstream belt; kinematic "
+            f"belt-like surface {cfg.belt_speed:.3f} m/s; servo v_max={SHUTTER_VMAX:.1f} "
+            f"a_max={SHUTTER_AMAX:.1f}"
+        )
+        say(
+            f"[pocket] floor=trapdoor {sx:.3f}x{gap:.3f}x0.030 slides {TRAP_TRAVEL:.3f} m along -Y "
+            f"into the recycle bin (floor z={bin_top:.4f}, {BIN_DEPTH * 1000:.0f} mm below the "
+            f"pocket); x walls inner faces at {bx - wall_x + 0.006:+.4f}/{bx + wall_x - 0.006:+.4f} "
+            f"(hand span 0.098 clears at the band edges)"
+        )
+
+    def _joint(self, name: str, body_path: str, lower: float, closed_centre) -> None:
+        # body0 is **unset**: the joint anchors to the world. Two kinematic bodies
+        # cannot be jointed ("cannot create a joint between static bodies",
+        # measured on the first build), and the shutter must stay kinematic for
+        # its belt-like surface velocity - so the USD joint carries the axis, the
+        # limits and the position target, and the pose is written by the servo
+        # along that axis (the measured time is the body's).
+        joint = UsdPhysics.PrismaticJoint.Define(self.stage, f"/World/Conveyor/{name}")
+        joint.CreateBody1Rel().SetTargets([Sdf.Path(body_path)])
+        joint.CreateAxisAttr().Set("Y")
+        joint.CreateLowerLimitAttr().Set(float(lower))
+        joint.CreateUpperLimitAttr().Set(0.0)
+        joint.CreateLocalPos0Attr().Set(
+            Gf.Vec3f(float(closed_centre[0]), float(closed_centre[1]), float(closed_centre[2]))
+        )
+        joint.CreateLocalRot0Attr().Set(Gf.Quatf(1.0, 0.0, 0.0, 0.0))
+        joint.CreateLocalPos1Attr().Set(Gf.Vec3f(0.0, 0.0, 0.0))
+        joint.CreateLocalRot1Attr().Set(Gf.Quatf(1.0, 0.0, 0.0, 0.0))
+        drive = UsdPhysics.DriveAPI.Apply(joint.GetPrim(), "linear")
+        drive.CreateTypeAttr().Set("force")
+        drive.CreateStiffnessAttr().Set(1e6)
+        drive.CreateDampingAttr().Set(1e4)
+        drive.CreateMaxForceAttr().Set(1e6)
+        drive.CreateTargetPositionAttr().Set(0.0)
+
+    # ------------------------------------------------------------------ #
+    @staticmethod
+    def _advance(pos: float, vel: float, target: float, lo: float, hi: float,
+                 vmax: float, amax: float, dt: float) -> tuple[float, float]:
+        """One bounded trapezoid step along the joint's axis (kinematic servo)."""
+        delta = float(target) - float(pos)
+        if abs(delta) < 1e-7:
+            return float(target), 0.0
+        direction = 1.0 if delta > 0 else -1.0
+        if vel * direction < 0.0:
+            vel = 0.0  # reversing: brake first
+        speed = abs(vel)
+        remaining = abs(delta)
+        if speed * speed / (2.0 * amax) >= remaining:
+            speed = max(0.0, speed - amax * dt)
+        else:
+            speed = min(vmax, speed + amax * dt)
+        step = min(speed * dt, remaining)
+        new_pos = float(np.clip(pos + direction * step, lo, hi))
+        if step >= remaining:
+            speed = 0.0
+        return new_pos, direction * speed
+
+    def _write(self, prim, path: str, x: float, y: float, z: float) -> None:
+        prim.set_world_poses(
+            positions=[[float(x), float(y), float(z)]],
+            orientations=[[1.0, 0.0, 0.0, 0.0]],
+        )
+
+    def step(self) -> None:
+        """Advance both servos by the measured sim-time delta (idempotent/tick)."""
+        if self._shutter_prim is None:
+            self._shutter_prim = RigidPrim(self.shutter_path)
+            self._trap_prim = RigidPrim(self.trapdoor_path)
+        from isaacsim.core.simulation_manager import SimulationManager
+
+        now = float(SimulationManager.get_simulation_time())
+        if self._last_t is None:
+            dt = 1.0 / 120.0
+        else:
+            dt = min(max(now - self._last_t, 0.0), 0.05)
+        self._last_t = now
+        if dt <= 0.0:
+            return
+        tgt = float(np.clip(self._shutter_target, -SHUTTER_TRAVEL, 0.0))
+        pos, vel = self._advance(
+            self._shutter_pos, self._shutter_vel, tgt, -SHUTTER_TRAVEL, 0.0,
+            SHUTTER_VMAX, SHUTTER_AMAX, dt,
+        )
+        if abs(pos - self._shutter_pos) > 1e-9 or abs(vel) > 1e-9:
+            self._shutter_pos, self._shutter_vel = pos, vel
+            self._write(
+                self._shutter_prim, self.shutter_path, self.bx,
+                self.mouth_y + pos, self.shutter_closed_z,
+            )
+        ttgt = float(np.clip(self._trap_target, -TRAP_TRAVEL, 0.0))
+        tpos, tvel = self._advance(
+            self._trap_pos, self._trap_vel, ttgt, -TRAP_TRAVEL, 0.0,
+            TRAP_VMAX, TRAP_AMAX, dt,
+        )
+        if abs(tpos - self._trap_pos) > 1e-9 or abs(tvel) > 1e-9:
+            self._trap_pos, self._trap_vel = tpos, tvel
+            self._write(
+                self._trap_prim, self.trapdoor_path, self.bx,
+                self.mouth_y + tpos, self.floor_top - 0.015,
+            )
+
+    # ------------------------------------------------------------------ #
+    def open(self) -> None:
+        self._shutter_target = -SHUTTER_TRAVEL
+
+    def close(self) -> None:
+        self._shutter_target = 0.0
+
+    def open_trap(self) -> None:
+        self._trap_target = -TRAP_TRAVEL
+
+    def close_trap(self) -> None:
+        self._trap_target = 0.0
+
+    @property
+    def shutter_pos(self) -> float:
+        return float(self._shutter_pos)
+
+    @property
+    def shutter_open(self) -> bool:
+        return self._shutter_pos <= -SHUTTER_TRAVEL + 5e-4
+
+    @property
+    def shutter_closed(self) -> bool:
+        return abs(self._shutter_pos) <= 5e-4
+
+    @property
+    def trap_open(self) -> bool:
+        return self._trap_pos <= -TRAP_TRAVEL + 5e-4
+
+    @property
+    def trap_closed(self) -> bool:
+        return abs(self._trap_pos) <= 5e-4
+
+    @property
+    def shutter_underside(self) -> float:
+        return self.belt_top - SHUTTER_THICK
+
+    def mouth_clear(self, spawner, exclude: int | None = None,
+                    margin: float = 0.05) -> bool:
+        """True when no fruit is over the gap (the shutter can move)."""
+        for s in spawner.samples:
+            if s.parked or s.index == exclude:
+                continue
+            p = np.asarray(spawner.position(s), dtype=float)
+            if (
+                abs(float(p[0]) - self.bx) < 0.28
+                and abs(float(p[1]) - self.mouth_y) < self.gap / 2.0 + margin
+                and float(p[2]) < self.belt_top + 0.12
+                and float(p[2]) > self.belt_top - 0.30
+            ):
+                return False
+        return True
+
+    def dump_path_clear(self) -> float:
+        """The trapdoor's slide can open without a fruit in its travel box [m]."""
+        return float(TRAP_TRAVEL)
+
+
