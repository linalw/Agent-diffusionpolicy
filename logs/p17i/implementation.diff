+        monitored phase's end while still latched - with the trigger tick and
+        rate, the drift at the trigger, the first applied step and the
+        post-response rate (the arrest check).
+        """
+        if not self._slide_gate_diag:
+            return
+        say(
+            f"[slide] {arm_name} idx={index} {book['phase']} "
+            f"response={int(book['used'])}/{self._slide_gate_max} "
+            f"trig@{int(book['trig_tick'])} "
+            f"rate={float(book['trig_rate']) * 1000:.1f}mm/s "
+            f"drift={float(book['trig_drift']) * 1000:.1f}mm "
+            f"step={float(book['trig_step']) * 1000:.1f}mm "
+            f"post={float(book['rate']) * 1000:.1f}mm/s "
+            f"end={'release' if released else 'phase'}"
+        )
+
+    def _slide_gate_summary(self, arm_name: str, index: int, book: dict) -> None:
+        """P17-B H1 row (diag-gated): one monitored phase's summary."""
+        if not self._slide_gate_diag:
+            return
+        say(
+            f"[slide] {arm_name} idx={index} {book['phase']} summary "
+            f"ticks={int(book['ticks'])} events={int(book['events'])} "
+            f"rate_max={float(book['rate_max']) * 1000:.1f}mm/s "
+            f"drift_max={float(book['drift_max']) * 1000:.1f}mm"
+        )
+
+    def _slide_gate_begin_phase(self, book: dict, phase: str) -> None:
+        """P17-B H1: reset the per-phase counters.
+
+        The attempt's drift reference and response budget carry across the
+        hold -> probe-1 span; only the reporting counters reset.
+        """
+        book["phase"] = phase
+        book["ticks"] = 0
+        book["events"] = 0
+        book["rate_max"] = 0.0
+        book["drift_max"] = 0.0
+
+    def _slide_gate_end_phase(self, arm_name: str, index: int, book: dict) -> None:
+        """P17-B H1: close a monitored phase.
+
+        A still-latched response is reported (`end=phase`) and released; the
+        phase summary follows.
+        """
+        if book["latched"]:
+            self._slide_gate_report(arm_name, index, book, False)
+            book["latched"] = False
+        self._slide_gate_summary(arm_name, index, book)
