+    def _slide_gate_tick(self, arm_name: str, index: int, book: dict, arm, sample) -> None:
+        """P17-B H1 post-step monitor glue: the reads + the observe call.
+
+        The carry diag's recipe, both post-step: the wrist quaternion from the
+        arm's TCP pose and the pads' measured centre (`pad_centre()`).
+        """
+        rot_now = _quat_matrix(np.asarray(arm.tcp_pose()[1], dtype=float))
+        pads_now = np.asarray(self.grippers[arm_name].pad_centre(), dtype=float)
+        fruit_now = np.asarray(self.spawner.position(sample), dtype=float)
+        rel_world = fruit_now - pads_now
+        if self._slide_gate_observe(book, rel_world, rot_now.T @ rel_world) == "release":
+            self._slide_gate_report(arm_name, index, book, True)
+
+    def _freeze2_split(self, reading) -> tuple[float, float]:
+        """P17-B H2: the per-face contact force [N] (left face, right face).
+
+        The tactile dict is keyed `<side>_<i>`; the shipped OpenArm hand
+        carries the two finger links as `_0`/`_1`, and the opt-in D2 soft pads
+        append `_2`/`_3` for the same two faces, so `i % 2` groups the
+        sensors by face (0 = the left finger face, 1 = the right). Empty or
+        malformed keys read zero.
+        """
+        left = 0.0
+        right = 0.0
+        for key, value in (getattr(reading, "fingertip_forces", None) or {}).items():
+            try:
+                face = int(str(key).rsplit("_", 1)[1]) % 2
+            except (IndexError, ValueError):
+                continue
+            force = float(value)
+            if face == 0:
+                left = max(left, force)
+            else:
+                right = max(right, force)
+        return left, right
+
+    def _freeze2_step(self, book: dict, reading) -> bool:
+        """P17-B H2: one close-tick two-sided-load sample.
+
+        Updates the per-close-attempt book (the running two-sided run, its max
+        and the per-face maxima for the row) and returns True when both faces
+        have carried at least `FRUIT_DYNAMIC_FREEZE_TWOSIDED_FORCE` for
+        `FRUIT_DYNAMIC_FREEZE_TWOSIDED_TICKS` consecutive ticks - the
+        load-sustained straddle the freeze commits on.
+        """
+        left, right = self._freeze2_split(reading)
+        book["face_l"] = max(float(book["face_l"]), left)
+        book["face_r"] = max(float(book["face_r"]), right)
+        if left >= self._freeze_twosided_force and right >= self._freeze_twosided_force:
+            book["run"] = int(book["run"]) + 1
+        else:
+            book["run"] = 0
+        book["run_max"] = max(int(book["run_max"]), int(book["run"]))
+        return int(book["run"]) >= self._freeze_twosided_ticks
+
+    def _freeze_twosided_report(
+        self,
+        arm_name: str,
+        index: int,
+        commit: str,
+        tick,
+        depth,
+        span,
+        split: tuple[float, float],
+        run: int,
+        shipped_tick,
+        shipped_depth,
+    ) -> None:
+        """P17-B H2 row (diag-gated): one freeze commit.
+
+        `commit` is `shipped` (the gate off, or the shipped path), `straddle`
+        (the two-sided commit) or `fallback` (the shipped criterion applied at
+        the close's horizon because the two-sided condition never obtained).
+        `ship=` carries the shipped-eligible record; `none` when the shipped
+        criterion never fired before a straddle commit.
+        """
+        if not self._freeze_twosided_diag:
+            return
+        left, right = split
+        ship = (
+            "none"
+            if shipped_tick is None
+            else f"{int(shipped_tick)}t/{float(shipped_depth) * 1000:.1f}mm"
+        )
+        say(
+            f"[freeze2] {arm_name} idx={index} commit={commit} "
+            f"tick={int(tick)} depth={float(depth) * 1000:.1f}mm "
+            f"span={float(span) * 1000:.1f}mm "
+            f"ft=({float(left):.2f},{float(right):.2f})N run={int(run)} "
+            f"ship={ship}"
+        )
