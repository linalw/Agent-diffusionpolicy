+    # ------------------------------------------------------------------ #
+    # P17-B: the capture-side levers (H1 the hold/probe-1 slide gate + the
+    # bounded in-place re-centre; H2 the freeze-side two-sided-load gate).
+    # Both default off and dynamic-capture scoped; see the knob block in
+    # `__init__` and `logs/p17/CAPTURE_LEVER_DESIGN.md` section 4.
+    # ------------------------------------------------------------------ #
+    def _slide_gate_observe(self, book: dict, rel_world, rel_frame) -> str | None:
+        """P17-B H1 monitor: one hand-frame drift sample (post-step).
+
+        `rel_world` is the payload's centre minus the pads' measured centre
+        (world frame) and `rel_frame` the same vector in the hand frame - the
+        W8-B carry-diag recipe (`rot.T @ (fruit - pads)` with the arm's TCP
+        quaternion), reused for the hold/probe-1 window the P14-B trace
+        localized. The first sample sets the references; later samples update
+        the drift *rate* (the per-tick change of `rel_world` over
+        `CONTROL_DT`) and the accumulated hand-frame drift (against the first
+        sample). Returns `"trigger"` when the over-band run reaches
+        `FRUIT_DYNAMIC_SLIDE_GATE_TICKS` while inside the recovery window and
+        the response budget (the caller's response then latches) and
+        `"release"` when a latched response's rate falls back under the band
+        (the arrest); otherwise `None`. Pure bookkeeping - the caller owns the
+        reads and the rows.
+        """
+        rel_world = np.asarray(rel_world, dtype=float)
+        rel_frame = np.asarray(rel_frame, dtype=float)
+        book["ticks"] = int(book["ticks"]) + 1
+        if book["ref"] is None:
+            book["ref"] = rel_frame.copy()
+            book["prev"] = rel_world.copy()
+            book["rate"] = 0.0
+            book["drift"] = 0.0
+            return None
+        book["rate"] = float(np.linalg.norm(rel_world - book["prev"])) / CONTROL_DT
+        book["prev"] = rel_world.copy()
+        book["drift"] = float(np.linalg.norm(rel_frame - book["ref"]))
+        book["rate_max"] = max(float(book["rate_max"]), float(book["rate"]))
+        book["drift_max"] = max(float(book["drift_max"]), float(book["drift"]))
+        band = self._slide_gate_mmps / 1000.0
+        if book["latched"]:
+            if book["rate"] < band:
+                # The arrest: release. The aim walks back to the shipped
+                # target at the same bounded step (the `_slide_gate_target`
+                # `releasing` state), so neither edge of the response is a
+                # single-tick command jump.
+                book["latched"] = False
+                book["releasing"] = True
+                return "release"
+            return None
+        if book["rate"] >= band:
+            book["run"] = int(book["run"]) + 1
+        else:
+            book["run"] = 0
+        if (
+            int(book["run"]) >= self._slide_gate_ticks
+            and int(book["used"]) < self._slide_gate_max
+            and book["drift"] <= self._slide_gate_window_mm / 1000.0
+        ):
+            book["latched"] = True
+            book["releasing"] = False
+            book["used"] = int(book["used"]) + 1
+            book["events"] = int(book["events"]) + 1
+            book["run"] = 0
+            book["trig_tick"] = int(book["ticks"])
+            book["trig_rate"] = float(book["rate"])
+            book["trig_drift"] = float(book["drift"])
+            book["trig_step"] = 0.0
+            return "trigger"
+        return None
+
+    def _slide_gate_target(self, book: dict, target, recentre) -> np.ndarray:
+        """P17-B H1 command: the jaw target under the slide gate.
+
+        Unlatched (or with the gate off - the helper is then never called) the
+        shipped `target` passes through unchanged. Latched, the aim moves from
+        the previously commanded target toward `recentre` - the payload's
+        measured centre with the `v * lead` feed-forward dropped - by at most
+        `FRUIT_DYNAMIC_SLIDE_GATE_STEP_MM` per tick, so the re-centring is a
+        bounded move and never a step. After the release the aim walks back to
+        the shipped target under the same step bound (the `releasing` state),
+        so neither edge of the response is a single-tick command jump. The
+        frozen gap and the wrist orientation are not part of the target and
+        are untouched. The first latched tick's applied step is recorded for
+        the `[slide]` row.
+        """
+        aim = np.asarray(target, dtype=float)
+        step = self._slide_gate_step_mm / 1000.0
+        if book["latched"] and book["aim"] is not None:
+            prev = np.asarray(book["aim"], dtype=float)
+            delta = np.asarray(recentre, dtype=float) - prev
+            norm = float(np.linalg.norm(delta))
+            if norm > step:
+                delta = delta * (step / norm)
+            aim = prev + delta
+            book["releasing"] = False
+            if float(book["trig_step"]) <= 0.0:
+                book["trig_step"] = float(np.linalg.norm(aim - prev))
+        elif book["releasing"] and book["aim"] is not None:
+            prev = np.asarray(book["aim"], dtype=float)
+            delta = np.asarray(target, dtype=float) - prev
+            norm = float(np.linalg.norm(delta))
+            if norm > step:
+                delta = delta * (step / norm)
+            aim = prev + delta
+            if float(np.linalg.norm(aim - np.asarray(target, dtype=float))) <= 1e-12:
+                book["releasing"] = False
+        else:
+            book["releasing"] = False
+        book["aim"] = aim.copy()
+        return aim
+
+    def _slide_gate_report(self, arm_name: str, index: int, book: dict, released: bool) -> None:
+        """P17-B H1 row (diag-gated): one response event.
