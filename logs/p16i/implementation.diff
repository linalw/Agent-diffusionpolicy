+    def _arrive_hold(self, arm, target, tol: float, max_ticks: int):
+        """P16 pick (a): bounded closed-loop arrival at the descent aim (default off).
+
+        The moving catch's descent is a jerk-limited *profile*: it ends where
+        the profile stops, not where the aim is - the measured `end=` shortfall
+        on the mass base is 8.1-15.3 mm (median 9.2;
+        `logs/p16/BOUNDARY_DESIGN.md` section 1.1). With
+        `FRUIT_DYNAMIC_ARRIVE_TOL > 0` **and** `FRUIT_DYNAMIC_ARRIVE_MAX > 0`
+        (either 0 = shipped, byte-unchanged) this loop re-commands the aim
+        (`ik_step(target)` + one physics tick per iteration, the same primitives
+        the profile above uses) until the *measured* TCP error against the aim
+        is at or below the tolerance or the tick cap has run, so the
+        post-descent solver (the catch-up) starts from the arrived pose. The
+        loop is deliberately upstream of the capture: unlike the close/carry
+        actuators (whose class re-draws traded the outcome, the P15 conserved
+        mass), a descent-side change hands the *shipped* carry its payload.
+
+        Returns ``(start_gap_m, settled_gap_m, ticks, residual_vec)`` when the
+        loop is active and ``None`` when it is off (the default); `_approach`
+        reports the settled gap through the motion row's `end=` and returns the
+        tuple so the moving catch can print the `[arrive]` row. Pure
+        control-loop work: one `ik_step` + one `_step_sim` per tick, no extra
+        readback on any shipped path.
+        """
+        if tol <= 0.0 or max_ticks <= 0:
+            return None
+        target = np.asarray(target, dtype=float)
+        residual = np.asarray(arm.tcp_position(), dtype=float) - target
+        start_gap = float(np.linalg.norm(residual))
+        gap = start_gap
+        ticks = 0
+        for _ in range(int(max_ticks)):
+            if gap <= tol:
+                break
+            arm.ik_step(target)
+            self._step_sim(1)
+            ticks += 1
+            residual = np.asarray(arm.tcp_position(), dtype=float) - target
+            gap = float(np.linalg.norm(residual))
+        return start_gap, gap, ticks, residual
+
